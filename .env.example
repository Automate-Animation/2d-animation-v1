# LLM provider selection: anthropic | gemini | openai | claude-cli
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5
# used only when LLM_PROVIDER=openai (Ollama/LM Studio/vLLM, any OpenAI-compatible /v1 endpoint)
LLM_BASE_URL=http://localhost:11434/v1
# optional override; defaults to 6 for gemini free tier, 0 otherwise
LLM_SLEEP_SECONDS=

# requires a real ANTHROPIC_API_KEY (sk-ant-api03-...); do not use an OAuth token (sk-ant-oat01-...)
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# claude-cli provider needs no key here -- it shells out to a locally logged-in `claude` CLI
# (LLM_MODEL becomes the --model value, e.g. "sonnet")
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# ignored by core.py: aligner is chosen automatically by whether --audio is passed
# (--audio -> Gentle, no --audio -> ElevenLabs synthesizes + aligns). Kept as a future hook.
ALIGNER=elevenlabs
